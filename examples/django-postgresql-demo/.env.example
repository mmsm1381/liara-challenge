# Copy to .env and replace the placeholders. Never commit a real .env.

# Django secret key. Generate a new, long random value for any real deployment.
SECRET_KEY=replace-with-a-long-random-string
# Comma-separated hostnames this app answers to.
ALLOWED_HOSTS=localhost,127.0.0.1
# Database host name or IP. If set, the DB_* variables below are used.
DB_HOST=database
# Database port (default 5432).
DB_PORT=5432
# Database name.
DB_NAME=bookings
# Database user.
DB_USER=demo
# Database password.
DB_PASSWORD=replace-with-database-password
# Alternative to the DB_* variables, used only when DB_HOST is unset:
# DATABASE_URL=postgres://demo:replace-with-database-password@database:5432/bookings
