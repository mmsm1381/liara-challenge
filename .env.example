# Copy to .env and replace the placeholders. Never commit a real .env.

# Django secret key. Required in production. Generate a long random string.
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# 1 enables debug mode (local only). Keep 0 in production.
DJANGO_DEBUG=0
# Comma-separated hostnames this app answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins for CSRF, e.g. https://assistant.example.liara.run
DJANGO_CSRF_TRUSTED_ORIGINS=

# Postgres connection URL (dj-database-url format). Compose sets this for you.
DATABASE_URL=postgres://assistant:assistant@localhost:5432/assistant
# Redis URL used by django-rq for the job queue.
REDIS_URL=redis://localhost:6379/0
# 1 runs RQ jobs inline in the web process (single-process demo, no worker needed).
RQ_SYNC=0
# Port gunicorn listens on in the Dockerfile CMD (read by the shell, not Django).
PORT=8000

# Directory for uploaded ZIPs awaiting the deploy job. Defaults to ./var/uploads.
UPLOAD_DIR=/app/var/uploads
# Maximum accepted upload size in bytes (default 50 MiB).
MAX_ZIP_BYTES=52428800

# Fernet key that encrypts stored Liara tokens. Required outside DEBUG.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key

# Liara control-plane API base URL.
LIARA_API_BASE=https://api.iran.liara.ir
# Liara object storage API base URL.
LIARA_STORAGE_API_BASE=https://storage-service.liara.ir
# Timeout in seconds for calls to Liara APIs.
LIARA_TIMEOUT=20
# 1 uses the in-memory/fake Liara client (no account needed). Shared via the appvar volume.
LIARA_FAKE=0

# OpenAI-compatible Liara AI endpoint. Replace <workspace-id> with yours.
LLM_BASE_URL=https://ai.liara.ir/api/<workspace-id>/v1
# API key for the Liara AI endpoint.
LLM_API_KEY=replace-with-liara-ai-api-key
# Model name passed to the endpoint.
LLM_MODEL=openai/gpt-4o-mini
# native uses provider tool calling; prompt_json asks the model for JSON instead.
LLM_TOOL_MODE=native
# Timeout in seconds for a single LLM request.
LLM_TIMEOUT=30
# Maximum LLM requests per day for the app.
LLM_DAILY_CAP=200

# Optional: read-only GitHub token so public-repo downloads aren't limited to 60/hour per server IP
GITHUB_TOKEN=
